# CLIENT CONFIGURATION ONLY. Copy to .env; fill your development project values.
# 'live' means real services, not public distribution.
VITE_APP_MODE=live
VITE_ENABLE_LICENSE_REDEMPTION=true

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_URL=ro.rezerva.app://auth/callback

# Optional until testing Google Play purchases. Use only the public Android SDK key.
VITE_REVENUECAT_GOOGLE_API_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=business_pro

VITE_APP_NAME=Rezerva
# Replace these placeholder policies before releasing to real customers.
VITE_SUPPORT_URL=https://example.com/support
VITE_PRIVACY_URL=https://rezervari-ai.com/privacy-policy
VITE_DELETE_ACCOUNT_URL=https://example.com/stergere-cont
VITE_TERMS_URL=https://rezervari-ai.com/terms-of-service
VITE_SMALL_PLAN_PRICE=50
VITE_LARGE_PLAN_PRICE=150

# Never put Resend, Twilio, Firebase private JSON, RevenueCat secret API key,
# Supabase service_role, database passwords, or license keys in this file.
