# BACKEND TESTS ONLY. Never source this file in Bash or put it in the APK.
# Run npm run test:backend:setup to create .env.backend.local without overwriting it.
# No network calls are permitted until BOTH target checks below are configured.
BACKEND_TEST_ENABLED=false
BACKEND_TEST_ENVIRONMENT=development
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
BACKEND_TEST_PROJECT_REF=

# Optional: real PostgreSQL tests. Prefer Connect > Session pooler (port 5432).
# Percent-encode special characters in the DB password. Certificate checks stay ON.
BACKEND_TEST_DATABASE_URL=
BACKEND_TEST_DB_CA_FILE=

# Step 5. Read-only domain inspection is optional and requires a key with read access.
# Do not broaden the deployed sending key. A separate local inspection key is optional.
RESEND_API_KEY=
RESEND_READ_API_KEY=
RESEND_DOMAIN_ID=
INVITE_FROM_EMAIL="Rezervari.ai <support@rezervari-ai.com>"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Step 6. A PRIVATE JSON file path, NOT Android's google-services.json.
# Git Bash on Windows: use C:/Users/David/private/firebase-service-account.json
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_FILE=
TEST_FCM_TOKEN=
CRON_SECRET=

# Explicitly allowlisted addresses/numbers/devices YOU control. No automatic defaults.
TEST_EMAIL_TO=
TEST_PHONE_TO=
TEST_DEVICE_OWNED=false

# Real Google users for deployed workflows. All must be YOUR test accounts.
# npm run test:backend:login -- owner (then customer, staff, admin) saves sessions locally.
# Configure these email addresses BEFORE login. Each role is checked against /auth/v1/user.
TEST_OWNER_EMAIL=
TEST_CUSTOMER_EMAIL=
TEST_STAFF_EMAIL=
TEST_ADMIN_EMAIL=davidnicolaparaschiv@gmail.com
# Alternatively supply an unexpired Supabase access token (not a Google token).
TEST_OWNER_ACCESS_TOKEN=
TEST_CUSTOMER_ACCESS_TOKEN=
TEST_STAFF_ACCESS_TOKEN=
TEST_ADMIN_ACCESS_TOKEN=

# Existing TEST business/calendars for booking, invitation and worker tests.
# A business created by enrollment-start is recorded in the local state automatically.
TEST_BUSINESS_ID=
TEST_CALENDAR_ID=
TEST_EVENT_TYPE_ID=
TEST_BUSINESS_OWNED=false
TEST_ENROLLMENT_CUI=
# Copy the actual mailbox tokens / real SMS code here only for the corresponding step.
TEST_EMAIL_LINK_TOKEN=
TEST_APPROVAL_LINK_TOKEN=
TEST_INVITE_TOKEN=
TEST_SMS_CODE=

# Optional billing: an EXISTING RevenueCat sandbox subscriber whose ID is your owner UUID.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_ENTITLEMENT_ID=business_pro
TEST_REVENUECAT_USER_ID=
TEST_EXPECTED_PLAN=

# Per-request timeout; finite, 1000..60000 milliseconds. No auto-retries for sends.
BACKEND_TEST_TIMEOUT_MS=15000
