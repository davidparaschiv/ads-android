# SERVER ONLY. Never add VITE_ to these names or copy secrets into the Android app.
# Supabase URL / ANON_KEY / SERVICE_ROLE_KEY are provided automatically in hosted functions.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=business_pro
REVENUECAT_WEBHOOK_AUTH=
RESEND_API_KEY=
# SMS phone proof; secrets remain on the server. Create a Twilio Verify service.
TWILLIO_ACCOUNT_SID=
TWILLIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Optional public/verify.html HTTPS landing page; otherwise direct Android link.
ENROLLMENT_WEB_URL=
INVITE_FROM_EMAIL="Rezervari.ai <support@rezervari-ai.com>"
# Optional HTTPS invitation landing page (see public/invite.html); otherwise custom Android link.
INVITE_WEB_URL=
CRON_SECRET=
FIREBASE_PROJID=
GCLOUD_SERVICEACCOUNT_KEYS=
# Full private service-account JSON, not Android google-services.json.
# OAuth credentials named SUPABASEGOOGLEOAUTH_CLIENTID and
# SUPABASEGOOGLEOAUTH_CLIENTSECRET must also be saved as VALUES in hosted
# Supabase Authentication -> Google provider (Client ID / Client Secret).
# Edge Function secrets alone do NOT configure the hosted Google provider.
ALLOWED_ORIGINS=https://localhost,http://localhost,http://localhost:5173
