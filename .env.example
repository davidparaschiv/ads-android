# Change only this file when connecting services, then save it as .env.
# Keep demo mode enabled until all accounts are configured.
VITE_APP_MODE=demo
VITE_ENABLE_LICENSE_REDEMPTION=true

# Supabase: Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# RevenueCat: Project -> API keys -> Google public SDK key
VITE_REVENUECAT_GOOGLE_API_KEY=
VITE_REVENUECAT_ENTITLEMENT_ID=business_pro

# Must match the Android app link/deep-link configuration.
VITE_AUTH_REDIRECT_URL=ro.rezerva.app://auth/callback

# Branding and plan values shown in the app.
VITE_APP_NAME=Rezerva
VITE_SUPPORT_URL=https://example.com/support
VITE_PRIVACY_URL=/privacy-policy.html
VITE_DELETE_ACCOUNT_URL=https://example.com/stergere-cont
VITE_TERMS_URL=/terms.html
VITE_SMALL_PLAN_PRICE=50
VITE_LARGE_PLAN_PRICE=150
